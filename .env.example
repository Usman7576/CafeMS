# Run "npm run setup:env" to create .env with freshly generated keys.
# Never commit .env. The server refuses to start if a key is missing or weak.
NODE_ENV=development
PORT=3000
# The replica set from docker-compose.yml. Transactions need a replica set.
MONGODB_URI=mongodb://127.0.0.1:27018/?directConnection=true
MONGODB_DB=cafems
# The exact origin staff use, with no trailing slash. Must be https in production.
APP_ORIGIN=http://localhost:3000
# Number of trusted reverse proxies in front of the app (Caddy counts as 1).
TRUST_PROXY=0
# Keyrings, as id:base64 of 32 random bytes, comma separated to support rotation.
JWT_KEYS=
JWT_ACTIVE_KEY=k1
DATA_KEYS=
DATA_ACTIVE_KEY=k1
# base64 of 32 random bytes, used to search encrypted phone numbers.
BLIND_INDEX_KEY=
# Ed25519 seeds that sign the audit log, as id:base64 of 32 random bytes. Old keys stay for verifying.
AUDIT_KEYS=
AUDIT_ACTIVE_KEY=k1
# base64 of 32 random bytes, shared with the payment gateway to sign its callbacks.
GATEWAY_SECRET=
# base64 of 32 random bytes. Used only by the backup scripts, so the server never needs it.
BACKUP_KEY=
# Folder for uploaded menu photos. Must be outside public/.
UPLOAD_DIR=uploads
