{
  "name": "cafems",
  "version": "3.0.0",
  "private": true,
  "description": "Cafe Management System with a secured Express and MongoDB server",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-concurrency=2 \"tests/**/*.test.js\"",
    "setup:env": "node scripts/setup-env.js",
    "db:setup": "node scripts/db-setup.js",
    "deps:report": "node scripts/dependency-report.js",
    "trace": "node scripts/check-traceability.js",
    "seed:dev": "node scripts/seed-dev.js",
    "vendor": "node -e \"require('fs').copyFileSync('node_modules/three/build/three.module.min.js','public/vendor/three.module.min.js')\"",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "lint": "eslint .",
    "test:coverage": "node --test --test-concurrency=2 --experimental-test-coverage --test-coverage-include=\"server/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 \"tests/**/*.test.js\"",
    "load-test": "node scripts/load-test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.12.0",
    "otplib": "^12.0.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1",
    "three": "^0.170.0"
  }
}
